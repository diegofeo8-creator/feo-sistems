# Copiá este archivo como ".env.local" y completá con los datos
# reales de tu proyecto Supabase (Configuración > API).
#
# Las que empiezan con NEXT_PUBLIC_ quedan visibles en el navegador:
# son seguras de exponer porque están protegidas por las políticas
# de seguridad (RLS) que definimos en supabase/schema.sql.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública final del sitio (sin barra al final). En desarrollo dejala
# en localhost; cuando publiquemos en Vercel (Fase 15) la actualizamos
# a tu dominio real. Se usa para generar URLs absolutas correctas en
# el sitemap y en las etiquetas Open Graph / Twitter Card.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Esta clave NUNCA debe ir en el navegador ni subirse a GitHub.
# Solo la vamos a usar en tareas administrativas puntuales del
# servidor (por ejemplo, scripts de carga masiva de datos de prueba).
SUPABASE_SERVICE_ROLE_KEY=
